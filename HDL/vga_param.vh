/*
 * VGA 640×480 用のタイミングパラメータ
 *
 * VGAでは、1画面を表示するときに
 *
 *   「実際に画像を表示する時間」
 *        ＋
 *   「同期信号などのための時間」
 *
 * が必要になる。
 *
 * そのため、
 *
 *   横方向：640ピクセル
 *   縦方向：480ライン
 *
 * だけではなく、
 * それ以外の時間も含めてタイミングを作る。
 *
 *
 * 【横方向】
 *
 *   ┌──────┬──────┬──────┬──────────────────────┐
 *   │FRONT │SYNC  │BACK  │     表示領域          │
 *   │ 16   │  96  │ 48   │       640             │
 *   └──────┴──────┴──────┴──────────────────────┘
 *
 *       ←────── 800クロック ──────→
 *
 *
 * 【縦方向】
 *
 *   ┌──────┬──────┬──────┬─────────────────────────┐
 *   │FRONT │SYNC  │BACK  │       表示領域           │
 *   │ 10   │  2   │ 33   │          480             │
 *   └──────┴──────┴──────┴─────────────────────────┘
 *
 *       ←──────── 525ライン ────────→
 *
 */


/*============================================================
 * 横方向（Horizontal）のタイミング
 *============================================================*/


/*
 * 1ライン分の合計クロック数
 *
 *   HFRONT + HWIDTH + HBACK + 640
 *
 * = 16 + 96 + 48 + 640
 * = 800
 *
 * つまり、1ラインを表示するために
 * 合計800個のピクセルクロックを使う。
 *
 * 「640なのになぜ800？」というのは、
 * 640は実際に画像を表示する部分だけだから。
 *
 *------------------------------------------------------------*/

localparam HPERIOD = 10'd800;


/*
 * Horizontal Front Porch
 *
 * 実際の画面表示が終わったあと、
 * 水平同期信号を出す前に設ける待ち時間。
 *
 * 16クロック分。
 *
 *------------------------------------------------------------*/

localparam HFRONT  = 10'd16;


/*
 * Horizontal Sync Width
 *
 * 水平方向の同期信号（VGA_HS）を出している時間。
 *
 * 96クロック分。
 *
 * VGAモニタは、この同期信号を使って
 * 「次のラインが始まる」と判断する。
 *
 *------------------------------------------------------------*/

localparam HWIDTH  = 10'd96;


/*
 * Horizontal Back Porch
 *
 * 水平同期信号が終わったあと、
 * 実際の画像表示を開始するまでの待ち時間。
 *
 * 48クロック分。
 *
 *------------------------------------------------------------*/

localparam HBACK   = 10'd48;


/*============================================================
 * 縦方向（Vertical）のタイミング
 *============================================================*/


/*
 * 1画面分の合計ライン数
 *
 *   VFRONT + VWIDTH + VBACK + 480
 *
 * = 10 + 2 + 33 + 480
 * = 525
 *
 * つまり、
 *
 *   480ライン = 実際の画像
 *
 * だけではなく、
 * 同期信号などに使う45ラインを加えて
 * 合計525ラインで1画面を構成する。
 *
 *------------------------------------------------------------*/

localparam VPERIOD = 10'd525;


/*
 * Vertical Front Porch
 *
 * 実際の画面表示が終わったあと、
 * 垂直同期信号を出す前の待ち時間。
 *
 * 10ライン分。
 *
 *------------------------------------------------------------*/

localparam VFRONT  = 10'd10;


/*
 * Vertical Sync Width
 *
 * 垂直同期信号（VGA_VS）を出している時間。
 *
 * 2ライン分。
 *
 * モニタはこの信号を使って
 * 「次の画面（フレーム）が始まる」
 * と判断する。
 *
 *------------------------------------------------------------*/

localparam VWIDTH  = 10'd2;


/*
 * Vertical Back Porch
 *
 * 垂直同期信号が終わったあと、
 * 実際の画像表示を開始するまでの待ち時間。
 *
 * 33ライン分。
 *
 *------------------------------------------------------------*/

localparam VBACK   = 10'd33;